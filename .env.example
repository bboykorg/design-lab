# ============================================================
#  Design&Lab — environment template (SAFE TO COMMIT: no real keys)
#  Copy to .env and fill in your own values:  cp .env.example .env
#  .env is git-ignored and must never be committed.
# ============================================================

# ---- Active AI provider (any OpenAI-compatible API) ----
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3-coder:free
AI_API_KEY=

AI_TEMPERATURE=0.5
AI_MAX_TOKENS=8192
AI_TIMEOUT=120

# ---- Server / app ----
STORE=json                 # json | sqlite
CORS_ORIGINS=*             # set your domain in production, not *
AUTH_ENABLED=0             # 1 to require login + private projects

# ============================================================
#  Optional: extra provider keys (only used if you add
#  multi-provider rotation; the default backend reads AI_API_KEY).
#  Comma-separated per provider.
# ============================================================
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEYS=

CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEYS=

GEMINI_API_KEY=

GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEYS=

MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEYS=
