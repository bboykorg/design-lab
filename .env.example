# Design Lab — backend proxy keys (SAFE TO COMMIT: placeholders only).
# Copy to .env and paste your own keys (comma-separated for several).
# On hosting set these as environment variables instead of a file.
# GoRouter (https://gorouter.app) — OpenAI-compatible Claude gateway
GOROUTER_API_KEYS=
# KiwiLLM (https://kiwillm.in) — keys look like Kiwi_live_...
KIWILLM_API_KEYS=
VYCE_API_KEYS=
CEREBRAS_API_KEYS=
OPENROUTER_API_KEYS=
GEMINI_API_KEYS=
GLM_API_KEYS=
MISTRAL_API_KEYS=
# OCR.space — распознавание текста на скриншотах (https://ocr.space/ocrapi)
OCR_SPACE_API_KEYS=
PUBLIC_URL=https://your-app.onrender.com
