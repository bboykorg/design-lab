# Design Lab — backend proxy keys (SAFE TO COMMIT: placeholders only).
# Copy to .env and paste your own keys (comma-separated for several).
# On Render set these as environment variables instead of a file.
# AgentRouter — шлюз (claude-opus-4-6, gpt-5.5, kimi-k3), https://agentrouter.org
AGENTROUTER_API_KEYS=
# Если шлюз даст другой base URL — меняется без правки кода:
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
VYCE_API_KEYS=
CEREBRAS_API_KEYS=
OPENROUTER_API_KEYS=
GEMINI_API_KEYS=
GLM_API_KEYS=
MISTRAL_API_KEYS=
# OCR.space — распознавание текста на скриншотах (https://ocr.space/ocrapi)
OCR_SPACE_API_KEYS=
PUBLIC_URL=https://your-app.onrender.com
